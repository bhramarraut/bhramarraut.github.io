# ============================================================
# BHRAMAR RAUT PORTFOLIO — .gitignore
# Static GitHub Pages site
# ============================================================


# ------------------------------------------------------------
# SECRETS / ENVIRONMENT VARIABLES
# NEVER commit credentials, API keys, tokens or passwords
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets

secrets/
private/

*.key
*.pem
*.p12
*.pfx
*.crt


# ------------------------------------------------------------
# OPERATING SYSTEM FILES
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*


# ------------------------------------------------------------
# EDITORS / IDE
# ------------------------------------------------------------

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains
.idea/
*.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Cursor
# Uncomment if you do NOT want Cursor project configuration in Git
# .cursor/

# Local editor history
.history/
.localhistory/
.vshistory/


# ------------------------------------------------------------
# TEMPORARY / BACKUP FILES
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.swp
*.swo

*~
~$*
.~lock.*

tmp/
temp/


# ------------------------------------------------------------
# LOGS
# ------------------------------------------------------------

*.log
logs/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# NODE / JAVASCRIPT
# Useful if tooling is added later
# ------------------------------------------------------------

node_modules/

.npm/
.pnpm-store/
.yarn/cache/

.cache/
.parcel-cache/
.vite/


# ------------------------------------------------------------
# PYTHON
# Useful for local scripts / automation
# ------------------------------------------------------------

__pycache__/
*.py[cod]

.venv/
venv/
env/


# ------------------------------------------------------------
# BUILD / TEST OUTPUT
# Only relevant if build tooling is added later
# ------------------------------------------------------------

coverage/
.nyc_output/

*.coverage
*.coveragexml


# ------------------------------------------------------------
# LOCAL DEVELOPMENT SERVERS / TOOLS
# ------------------------------------------------------------

.firebase/
.vercel/
.netlify/

.selenium/
.playwright/


# ------------------------------------------------------------
# ARCHIVE / SCRATCH FILES
# Uncomment ONLY if these are temporary copies.
# Do not uncomment if archives are intentional portfolio assets.
# ------------------------------------------------------------

# *.zip
# *.rar
# *.7z


# ------------------------------------------------------------
# IMPORTANT — PORTFOLIO FILES THAT MUST REMAIN TRACKED
# ------------------------------------------------------------

# DO NOT ignore:
#
# index.html
# Certification/
# Profile Pic/
# Resume/
# CV/
# Projects/
# screenshots/
# portfolio PDFs/images
#
# These are part of the public GitHub Pages website.
